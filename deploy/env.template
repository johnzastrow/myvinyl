# Template for the .env file next to compose.yaml. Copy it there, fill it in, and
# restrict it (chmod 600 .env). Never commit the filled-in file.
# Generate the first two values with:
#   docker compose run --rm myvinyl python -m myvinyl.credentials

# Signs session cookies. 32+ random characters.
MYVINYL_SECRET_KEY=

# Argon2id hash of the first admin's password. Only used on the very first start, when the
# database has no accounts yet. Keep the single quotes: the hash contains $ characters.
MYVINYL_PASSWORD_HASH=''
MYVINYL_ADMIN_USER=admin

# Optional shared Discogs personal token (60 requests/min instead of 25).
MYVINYL_DISCOGS_TOKEN=

# Host port Caddy proxies to (published on 127.0.0.1 only). Match it in the Caddy block.
MYVINYL_HOST_PORT=8085

# Optional tuning (defaults shown).
# MYVINYL_REFRESH_DAYS=7
# MYVINYL_BACKUP_HOURS=24
# MYVINYL_BACKUP_KEEP=14
# MYVINYL_TRASH_DAYS=30
